

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wholesale-b2b",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wholesale-b2b-db",
      "database_id": "050ac377-adcb-4ecf-9236-209ed59f32d8",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://wholesale-b2b.khushvikja.workers.dev",
    "COOKIE_SECURE": "true"
  }
}
